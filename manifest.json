{
  "manifest_version": 3,
  "name": "Creator Harness",
  "short_name": "Creator Harness",
  "version": "1.0.0",
  "description": "Ruang kerja Konten Kreator dalam satu sidebar: ide & hook, naskah, kalender, produksi, panen aset, brand kit, deal, analitik, dan otomasi.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Creator Harness — buka sidebar",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background/ServiceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/PageHarvest.js", "content/PageRpa.js", "content/ContentBridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "alarms",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/*",
        "ui/*",
        "core/*",
        "llm/*",
        "license/*",
        "onboarding/*",
        "rpa/*",
        "scrapers/*",
        "pipeline/*",
        "connectors/*",
        "config/*",
        "services/*",
        "demo/*",
        "assets/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Tampilkan/sembunyikan sidebar Creator Harness"
    },
    "toggle-fullscreen": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Mode fullscreen Creator Harness"
    }
  }
}
