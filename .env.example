# Contoh file .env untuk import lewat Settings -> Koneksi -> Import .env.
# File .env asli TIDAK boleh di-commit (lihat .gitignore).
# Semua nilai di bawah disimpan terenkripsi di SecretVault, bukan di pengaturan biasa.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

PLATFORM_URL=
INGEST_TOKEN=
